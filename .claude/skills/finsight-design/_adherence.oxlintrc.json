{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/bands/**",
              "components/buttons/**",
              "components/cards/**",
              "components/forms/**",
              "components/navigation/**",
              "components/trading/**",
              "ui_kits/developer-platform/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|fill|key|ref|className|style|children)$/]",
        "message": "<AssetIcon> doesn't accept that prop. Declared props: symbol, size, fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|ticker|price|change|iconFill|tone|divider|key|ref|className|style|children)$/]",
        "message": "<AssetRow> doesn't accept that prop. Declared props: name, ticker, price, change, iconFill, tone, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AssetRow> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<BadgePill> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<BadgePill> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|primary-active|secondary-light|secondary-dark|outline-on-dark|tertiary-text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'primary-active' | 'secondary-light' | 'secondary-dark' | 'outline-on-dark' | 'tertiary-text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|headline|subhead|actions|key|ref|className|style|children)$/]",
        "message": "<CTABand> doesn't accept that prop. Declared props: tone, headline, subhead, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<CTABand> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|media|tone|border|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: title, eyebrow, media, tone, border."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<FeatureCard> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|headline|subhead|actions|mockups|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: tone, eyebrow, headline, subhead, actions, mockups."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<HeroBand> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|direction|align|key|ref|className|style|children)$/]",
        "message": "<PriceCell> doesn't accept that prop. Declared props: value, direction, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCell'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<PriceCell> direction must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCell'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<PriceCell> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|cadence|features|cta|featured|onSelect|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: name, price, cadence, features, cta, featured, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductUICard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|meta|rotate|width|key|ref|className|style|children)$/]",
        "message": "<ProductUICard> doesn't accept that prop. Declared props: tone, title, meta, rotate, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductUICard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<ProductUICard> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|width|key|ref|className|style|children)$/]",
        "message": "<SearchPill> doesn't accept that prop. Declared props: placeholder, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|links|activeLink|onNavigate|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: tone, links, activeLink, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|on-dark)$/]",
        "message": "<TopNav> tone must be one of 'light' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|size|href|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: text, tone, size, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|ink|on-dark)$/]",
        "message": "<Wordmark> tone must be one of 'primary' | 'ink' | 'on-dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
